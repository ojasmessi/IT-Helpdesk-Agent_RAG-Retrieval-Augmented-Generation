# Copy this file to .env and fill in ONE provider.

# Option A — Groq (free tier, fast). Get a key at https://console.groq.com/keys
# LLM_MODEL=groq:llama-3.3-70b-versatile
# GROQ_API_KEY=your_key_here

# Option B — Ollama (100% local & free). Install from https://ollama.com then: ollama pull llama3.1
LLM_MODEL=ollama:llama3.1

# Option C — OpenAI (paid)
# LLM_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=your_key_here

# Optional: LangSmith tracing — see every LLM call and node in a web dashboard (free tier)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_key_here
# LANGSMITH_PROJECT=it-desk-agent
